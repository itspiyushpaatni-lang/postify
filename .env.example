# Minimal configuration. Every other option (more networks, S3/R2 storage,
# short links, SSO...) is documented in .env.full.example.

# --- Core (required) ---------------------------------------------------------
DATABASE_URL="postgresql://app:app@localhost:5432/app"
REDIS_URL="redis://localhost:6379"
TEMPORAL_ADDRESS="localhost:7233"
JWT_SECRET="replace-with-a-long-random-string"      # openssl rand -hex 32
POSTGRES_PASSWORD="replace-me"                      # only used by docker-compose.lean.yaml

# The exact public URLs. Locally: frontend on 4200, API on 3000.
# Behind docker-compose.lean.yaml: FRONTEND_URL=https://app.example.com and
# NEXT_PUBLIC_BACKEND_URL=https://app.example.com/api
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
# NOT_SECURED=true            # only when serving over plain http on a non-localhost host

IS_GENERAL="true"
NX_ADD_PLUGINS=false
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/absolute/path/to/uploads"
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/uploads"

# --- Brand (build time) ------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
# AGPL: link to where users can download the source of the version you run.
NEXT_PUBLIC_SOURCE_URL=""
# NEXT_PUBLIC_DOCS_URL=""     # your own API docs; defaults to the upstream docs

# --- Email (optional) --------------------------------------------------------
# Without a provider, new accounts are activated immediately and no emails
# (password reset, invites) are sent.
# EMAIL_PROVIDER="resend"     # resend | ses | nodemailer
# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS="hello@example.com"
# EMAIL_FROM_NAME="Postify"

# --- AI (off by default) -----------------------------------------------------
# Leave OPENAI_API_KEY empty and every AI button, the Agent page and the AI
# endpoints are hidden/disabled. Add a key later to switch them on.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1"      # model for the week planner and variations
# OPENAI_BASE_URL=""          # any OpenAI-compatible endpoint

# --- Billing (Stripe) --------------------------------------------------------
# Leave empty to run without billing: every account gets all features.
# With keys set, new accounts must pick a plan (7-day trial).
STRIPE_PUBLISHABLE_KEY=""     # pk_test_...
STRIPE_SECRET_KEY=""          # sk_test_...
STRIPE_SIGNING_KEY=""         # whsec_... for the endpoint {NEXT_PUBLIC_BACKEND_URL}/stripe
FEE_AMOUNT=0.05
# NEXT_PUBLIC_SELLABLE_TIERS="STANDARD,PRO"

# --- Social networks ---------------------------------------------------------
# Each network needs your own developer app. Redirect URL for all of them:
#   {FRONTEND_URL}/integrations/social/<provider>   e.g. .../integrations/social/x
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
FACEBOOK_APP_ID=""            # Facebook pages + Instagram (business) share one Meta app
FACEBOOK_APP_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
YOUTUBE_CLIENT_ID=""          # also powers "Continue with Google" sign-in
YOUTUBE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_LOGIN="true"
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
# HIDDEN_PROVIDERS="skool,nostr,lemmy"   # hide networks you do not support

API_LIMIT=30
